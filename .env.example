CANVAS_BASE_URL=https://byui.instructure.com
CANVAS_PROVIDER=browser
CANVAS_BRIDGE_HOST=127.0.0.1
CANVAS_BRIDGE_PORT=47821
# Default private pairing state: ~/.local/state/autocanvas/bridge
# CANVAS_BRIDGE_STATE_DIR=/absolute/private/path/bridge
# Cache defaults to ./data/canvas.sqlite; workspaces to ./workspaces
# CANVAS_DB_PATH=/absolute/private/path/canvas.sqlite
# CANVAS_WORKSPACE_ROOT=/absolute/private/path/workspaces
CANVAS_TIMEZONE=America/Denver
LOG_LEVEL=info
# No Canvas token, password or cookie is used by the browser provider.
